<mjml>
  <mj-head>
    <mj-style>
      * { box-sizing: border-box; } .link-color:hover { font-weight: bold; text-decoration: underline; } .small-link-color:hover { font-weight: bold; color: #000000; text-decoration: underline; } .footer-links { color: #000;
      text-decoration: none; } .footer-links:hover { color: #000000; text-decoration: none; } @media only screen and (max-width:480px) { .footer-links { color: red; text-decoration: none; } .footer-links:hover{ color: red; text-decoration:
      none; } }
    </mj-style>
    <mj-style inline="inline"
      >.main-wrapper { width: 696px; padding: 0; margin: 0 auto;} .header { background-color: #ffffff; color: #737474; } .section-padding { padding-left: 30px; padding-right: 30px; } .footer { padding: 0; margin: 0; background-size: 696px;
      width: 100%;} .footer-text { padding: 10px 0px 0px 0px !important; width: 100%; } .content-background { background-color: #ffffff; width: 100%; padding: 0; }.costco_btn:hover { background-color: #005bb5 !important; transform:
      scale(1.05); }
    </mj-style>
  </mj-head>

  <mj-body background-color="#ffffff" css-class="main-wrapper">
    <mj-wrapper css-class="content-background" padding="0">
      <mj-raw>
        <!-- HEADER SECTION -->
      </mj-raw>
      <mj-include path="./components/header.mjml" />
      <!-- END HEADER SECTION -->
      <mj-raw>
        <!-- HERO HEADER LINKS SECTION -->
      </mj-raw>
      <mj-section padding="10px 0px 10px 0px" margin="0" width="100%">
        <mj-column width="25%" align="center" padding="5px 0px">
          <mj-image
            alt="costcoBD_logo"
            href="https://www.costcobusinessdelivery.com/savings-event.html"
            style="align: center; display: block"
            margin="0"
            padding="0"
            font-size="0"
            border-radius="10px"
            target="_blank"
            width="150px"
            height="50px"
            align="center"
            src="https://www.costcobusinessdelivery.com/wcsstore/CostcoGLOBALSAS/images/logo-bd-us.png"
          />
        </mj-column>
        <mj-column width="25%" align="center" padding="5px 10px">
          <mj-image
            alt="costcoBD_logo"
            href="https://www.costcobusinessdelivery.com/s?keyword=instant+savings&ref=toprow"
            style="align: center; display: block"
            margin="0"
            padding="0"
            font-size="0"
            border-radius="10px"
            target="_blank"
            width="150px"
            height="50px"
            align="center"
            src="http://127.0.0.1:5500/assets/instant_savings.webp"
          />
        </mj-column>
        <mj-column width="25%" align="center" padding="5px 10px">
          <mj-image
            alt="costcoBD_logo"
            href="https://www.costcobusinessdelivery.com/s?keyword=New&what%27s-new=new&refine=%7C%7CWhat_s_New_attr-NEW"
            style="align: center; display: block"
            margin="0"
            padding="0"
            font-size="0"
            border-radius="10px"
            target="_blank"
            width="150px"
            height="50px"
            align="center"
            src="http://127.0.0.1:5500/assets/whatsnew.webp"
          />
        </mj-column>
        <mj-column width="25%" align="center" padding="5px 0px">
          <mj-image
            alt="costcoBD_logo"
            href="https://www.costcobusinessdelivery.com/OrderByItemsDisplayViewBD?ref=toprow"
            style="align: center; display: block"
            margin="0"
            padding="0"
            font-size="0"
            border-radius="10px"
            target="_blank"
            width="150px"
            height="50px"
            align="center"
            src="http://127.0.0.1:5500/assets/orderbyitem.webp"
          />
        </mj-column>
      </mj-section>
      <mj-raw>
        <!-- END HERO HEADER LINKS SECTION -->
      </mj-raw>
      <mj-raw>
        <!-- MAIN HERO IMAGE -->
      </mj-raw>
      <mj-section>
        <mj-column width="100%" padding="0">
          <mj-image
            href="https://www.costcobusinessdelivery.com/companyoverview.html"
            target="_blank"
            width="696px"
            padding="0"
            margin="0"
            font-size="0"
            src="http://127.0.0.1:5500/assets/costcobd-hero1.webp"
            style="src: https://cdn.bfldr.com/52U6WI5T/at/pvr98gwghb4zpcw8jsn4s75z/lp-companyoverview-hero.jpg?auto=webp&format=jpg"
          />
        </mj-column>
      </mj-section>
      <mj-raw>
        <!-- END MAIN HERO IMAGE -->
      </mj-raw>
     <mj-section>
       <mj-raw>
        <!-- Help Your Business-->
      </mj-raw>
      
      <mj-section padding="50px 0 0 0" width="100%" background-color="#ffffff">
          <mj-text width="100%" align="center" font-size="36px" font-weight="bold" line-height="40px" color="#000000">Discover How We Can Help Your Business</mj-text>
      </mj-section>
      <!-- Row 1 -->
      <mj-section>
        <mj-column width="50%">
          <mj-image
            href="https://www.costcobusinessdelivery.com/foodservice.html"
            target="_blank"
            width="300px"
            height="auto"
            padding="0"
            margin="0"
            
            src="http://127.0.0.1:5500/assets/foodservice
            .jpg"/>
        </mj-column>
        <mj-column width="50%" padding="30px 0 0 0">
          <mj-text font-family="'Helvetica Neue', Arial, Helvetica, sans-serif;" align="center" font-size="25px" font-weight="400" line-height="40px" color="#be5b68">
            Food Service
          </mj-text>
        </mj-column>
      </mj-section>

<!-- Row 2 -->
<mj-section>
  <mj-column width="50%">
    <!-- Left content -->
  </mj-column>
  <mj-column width="50%">
    <!-- Right content -->
  </mj-column>
</mj-section>

<!-- Row 3 -->
<mj-section>
  <mj-column width="50%">
    <!-- Left content -->
  </mj-column>
  <mj-column width="50%">
    <!-- Right content -->
  </mj-column>
</mj-section>

<!-- Row 4 -->
<mj-section>
  <mj-column width="50%">
    <!-- Left content -->
  </mj-column>
  <mj-column width="50%">
    <!-- Right content -->
  </mj-column>
</mj-section>
      <mj-section padding="20px 40px 40px 40px" background-color="#ffffff">
        <mj-column>
          
        </mj-column>
      </mj-section>
      <mj-raw>
        <!-- END Help Your Business-->
      </mj-raw>
      </mj-section>
      <mj-raw>
        <!-- CTA LM SECTION-->
      </mj-raw>
      <mj-section padding="30px 0 0 0" width="100%" background-color="#EFEFEF">
        <mj-column>
          <mj-text align="center" font-size="36px" font-weight="bold" line-height="40px" color="#212b35"> Spend $250 or more <span style="color: #e31837; font-size: 42px">FREE</span> delivery on us. </mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="20px 40px 20px 40px" background-color="#EFEFEF">
        <mj-column>
          <mj-button css-class="costco_btn" href="https://www.costcobusinessdelivery.com/" background-color="#015FAE" color="#ffffff" font-size="16px" font-weight="bold" border-radius="4px" padding="12px 40px" width="200px">
            Learn More
          </mj-button>
        </mj-column>
      </mj-section>
      <mj-raw>
        <!-- END CTA LM SECTION-->
      </mj-raw>

      <mj-raw>
        <!-- App Banner -->
      </mj-raw>
      <mj-section padding="20px 0px">
          <mj-column padding="0">
            <mj-image padding="0" align="center" href="https://www.costco.com/costco-app.html?EMID=B2C_2025_1227_TreasureHunt_USE&correlationId=801c0927-d222-4947-a931-454a232cbf58-0" target="_blank" src="https://mobilecontent.costco.com/staging/resource/img/22w0299/d-em-banner-22w0299-app.png" width="696px" height="auto" />
          </mj-column>
      </mj-section>
      </mj-raw>
        <!-- END App Banner -->
      <mj-raw>
        <!-- Footer -->
      </mj-raw>
      <mj-include path="./components/footer.mjml" />
      <mj-raw>
        <!-- END Footer -->
      </mj-raw>
    </mj-wrapper>
  </mj-body>
</mjml>
